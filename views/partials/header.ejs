          <%= __('nav.o_ejsu') %>
        </a>
        <ul class="dropdown-menu submenu">
          <li><a class="dropdown-item" href="<%= navHref %>/o_ejsu"><%= __('nav.o_ejsu') %></a></li>
          <li><a class="dropdown-item" href="<%= navHref %>/o_ejsu_primer"><%= __('nav.o_ejsu_primer') %></a></li>
          <li><a class="dropdown-item" href="<%= navHref %>/o_ejsu_primer_napredno"><%= __('nav.o_ejsu_primer_napredno') %></a></li>
          <li><a class="dropdown-item" href="<%= navHref %>/o_ejsu_primer_napredno_2"><%= __('nav.o_ejsu_primer_napredno_2') %></a></li>
