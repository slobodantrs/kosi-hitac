</nav>

<!-- Jeziчки „toggle“ -->
<div class="language-switcher">
  <% if (isEn) { %>
    <a href="<%= basePath %>">🇷🇸 Српски</a>
  <% } else { %>
    <a href="/en<%= basePath === '/' ? '' : basePath %>">🇬🇧 English</a>
  <% } %>
</div>
