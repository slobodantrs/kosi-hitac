<%
  const isEng = locale === 'en';

  // кад смо на српском, циљна en-рутa је slugMap[currentPath]
  // кад смо на енглеском, циљна sr-рутa је slugMapInverse[currentPath]
  const enSlug = slugMap[currentPath];            // нпр. '/' → '/en/'
  const srSlug = slugMapInverse[currentPath];     // нпр. '/en/' → '/'
debugger;
  // fallback: ако рутa није у мапи, једноставно уклони `^/en` или додај `'/en'`
  const target = isEng
    ? (srSlug || currentPath.replace(/^\/en/, '') || '/')
    : (enSlug || `/en${currentPath}`);

%>

<div class="language-switcher">
  <% if (isEn) { %>
    <a href="<%= target %>">🇷🇸 Српски</a>
  <% } else { %>
    <a href="<%= target %>">🇬🇧 English</a>
  <% } %>
</div>
