<% 
  const isEn = locale === 'en';
  const key = currentPath; 
  const target = isEn
    // if we’re on an /en/... URL, look it up in the inverse map, fall back to stripping "/en"
    ? (slugMapInverse[key] || key.replace(/^\/en/, '') || '/')
    // if we’re on a Serbian URL, map it to English via slugMap
    : (slugMap[key]    || ('/en' + key));
	
	
%>

