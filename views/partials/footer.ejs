<!-- views/partials/footer.ejs -->
<footer class="bg-light py-4 mt-5">
  <div class="container">
    <div class="row">

      <!-- Navigacija u footeru -->
      <div class="col-md-4 mb-3">
        <h5><%= __('footer.quick_links') %></h5>
        <ul class="list-unstyled">
          <li><a href="/" class="text-muted"><%= __('nav.home') %></a></li>
          <li><a href="/o_ejsu" class="text-muted"><%= __('nav.o_ejsu') %></a></li>
          <li><a href="/kosi_hitac" class="text-muted"><%= __('nav.kosi_Hitac') %></a></li>
          <li><a href="/ravno_kretanje" class="text-muted"><%= __('nav.ravno_Kretanje') %></a></li>
        </ul>
      </div>

      <!-- Društvene mreže -->
      <div class="col-md-4 mb-3">
        <h5><%= __('footer.connect') %></h5>
        <ul class="list-inline">
          <li class="list-inline-item">
            <a href="#" class="text-muted" aria-label="Facebook">
              <i class="fab fa-facebook fa-lg"></i>
            </a>
          </li>
          <li class="list-inline-item">
            <a href="#" class="text-muted" aria-label="Twitter">
              <i class="fab fa-twitter fa-lg"></i>
            </a>
          </li>
          <li class="list-inline-item">
            <a href="#" class="text-muted" aria-label="LinkedIn">
              <i class="fab fa-linkedin fa-lg"></i>
            </a>
          </li>
        </ul>
      </div>

      <!-- Kontakt / autorstvo -->
      <div class="col-md-4 text-md-right">
        <p class="text-muted mb-1">© 2025 Svet programiranja — Kosi Hitac</p>
        <p class="text-muted small mb-0">
          <a href="/privacy" class="text-muted"><%= __('footer.privacy_policy') %></a> ·
          <a href="/terms" class="text-muted"><%= __('footer.terms_of_use') %></a>
        </p>
      </div>

    </div>
  </div>
</footer>
