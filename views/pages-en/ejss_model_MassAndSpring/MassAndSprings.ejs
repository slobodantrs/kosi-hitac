
<!DOCTYPE html>
<html lang="<%= locale %>">
  <head>
  <% include ../../partials/head %>
   <!-- Meta opis -->
<!-- Meta Description -->
<meta name="description" content="Interactive simulation of a mass-spring system. Explore the fundamentals of simple harmonic motion, analyze forces and accelerations, and observe how mass and spring stiffness affect oscillation dynamics. Simulation created using Easy Java Simulation (EJS).">

<!-- Keywords -->
<meta name="keywords" content="mass-spring system, simple harmonic motion, Hooke's law, spring constant, oscillation, physics simulation, interactive simulation, Easy Java Simulation, EJS, dynamics, force analysis, acceleration, velocity, displacement">

<!-- Canonical Link -->
<link rel="canonical" href="https://kosi-hitac.onrender.com/mass_and_spring">

<title>Mass and Spring Simulation</title>

	
  </head>
  <body>
  <div class="container moj-header">

  
  <div class="content-wrapper moj-header">
   
    <% include ../../partials/header %>


</div>

   
     <div id="contents_mass_and_spring" class="intro_1">
        <div class="intro_1">
		<%- include(path1); %>
      
        </div>
        <div id="introduction_mass_and_spring" class="intro_2">
        <%- include(path2); %>

        </div>
      </div>
	  
   
   <div class="row">
   <div class="col-xs-12 col-md-12 col-lg-12">
   <footer>
	<% include ../../partials/scripts %>
    <% include ../../partials/footer %>
</footer>
</div>
   </div>
	</div>
	
	<script>
 
  document.addEventListener('DOMContentLoaded', () => {
  const introEl = document.getElementById('introduction_mass_and_spring');
  document.getElementById('contents_mass_and_spring').addEventListener('click', async e => {
    const a = e.target.closest('a[data-id]');
    if (!a) return;
    e.preventDefault();
    
    /* 1) дохвати HTML фрагмент*/
    const resp = await fetch(a.href);
    const html  = await resp.text();
    
    // 2) парсирај у привремени DIV
    const tmp = document.createElement('div');
    tmp.innerHTML = html;
    
    // 3) ишчупај script тагове и премести их у body
    tmp.querySelectorAll('script').forEach(old => {
	  if (old.src && old.src.includes('textresizedetector.js')) return;
      const s = document.createElement('script');
      if (old.src)        s.src = old.src;
      else                 s.textContent = old.textContent;
      document.body.appendChild(s);
    });
    
    // 4) убaci саму симулацију у uvod_slobodan_pad
    if (a.dataset.id === 'simulation_mass_and_spring') {
      // simulacija: izvuci njen kontejner
      frag = tmp.querySelector('#_topFrame') || tmp.querySelector('#ejs-container');
      introEl.innerHTML = '';
      if (frag) introEl.appendChild(frag);
	  // 5) иницијализуј симулацију одмах
   if (typeof initMassAndSpringSimulation === 'function') {
       initMassAndSpringSimulation();
   }
    } else {
	 if (window._model && typeof window._model.pause === 'function') {
        window._model.pause();        // stop its internal timer
        window._model = null;         // forget it entirely
      }
      // intro stranice: uzmi sav HTML
	  
      introEl.innerHTML = tmp.innerHTML;
    }
	
  });
});

</script>

  </body>
</html>
