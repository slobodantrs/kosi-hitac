
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:epub="http://www.idpf.org/2007/ops">
  <head>
   <%- include('../../partials/head') %>
    <link rel="canonical" href="https://kosi-hitac.onrender.com/en/projectile_motion" />
<title>Projectile Motion Simulation – Interactive Physics with EJS</title>

<meta name="author" content="Slobodan Tršek"/>

  </head>
  <body>
  <div class="container moj-header">
 
  <div class="header moj-header content">
   
    <%- include('../../partials/header') %>

</div>
<div class="row">
<h1>Projectile motion</h1>

</div>
 
     <div id="contents_projectile_motion" class="intro_1">
        <div class="intro_1">
		<%- include(path1); %>
		<% console.log('contents_projectile_motion:intro1') %>
      
        </div>
        <div id="introduction_projectile_motion" class="intro_2">
         <%- include(path2); %>
		 <% console.log('contents_projectile_motion:intro1') %>
     

        </div>
      </div>
    
  
   
      <div class="row">
   <div class="content">
   <footer>
	<%- include('../../partials/scripts') %>
    <%- include('../../partials/footer') %>
</footer>
</div>
</div>
</div>
<script>
 
  document.addEventListener('DOMContentLoaded', () => {
  console.log('DOMContentLoaded fired');
  const introEl = document.getElementById('introduction_projectile_motion');
  const sadrzaj = document.getElementById('contents_projectile_motion');
  console.log('Found #introduction_projectile_motion:', introEl);
  
console.log('Found #contents_projectile_motion:', sadrzaj);
  sadrzaj.addEventListener('click', async e => {
   console.log('addEventListener fired');
    const a = e.target.closest('a[data-id]');
    if (!a) return;
    e.preventDefault();
    
    /* 1 дохвати HTML фрагмент*/
    const resp = await fetch(a.href);
    const html  = await resp.text();
    
    // 2) парсирај у привремени DIV
    const tmp = document.createElement('div');
    tmp.innerHTML = html;
    
    // 3) ишчупај script тагове и премести их у body
    tmp.querySelectorAll('script').forEach(old => {
	  if (old.src && old.src.includes('textresizedetector.js')) return;
      const s = document.createElement('script');
      if (old.src)        s.src = old.src;
      else                 s.textContent = old.textContent;
      document.body.appendChild(s);
    });
    
    // 4) убaci саму симулацију у uvod_vertikalni_hitac
    if (a.dataset.id === 'simulation_projectile_motion') {
      // simulacija: izvuci njen kontejner
	 
      frag = tmp.querySelector('#_topFrame') || tmp.querySelector('#ejs-container');
      introEl.innerHTML = '';
      if (frag) introEl.appendChild(frag);
	  // 5) иницијализуј симулацију одмах
   if (typeof initProjectileMotionSimulation === 'function') {
       initProjectileMotionSimulation();
   }
    } else {
	 if (window._model && typeof window._model.pause === 'function') {
        window._model.pause();        // stop its internal timer
        window._model = null;         // forget it entirely
      }
      // intro stranice: uzmi sav HTML
	  
      introEl.innerHTML = tmp.innerHTML;
    }
	
  });
});
</script>

  </body>
</html>
