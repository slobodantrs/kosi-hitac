  _model.addToEvolution(function() {
    if (!__pagesEnabled["simulacija"]) return;
    z = z + vz * dt - 0.5* g * dt * dt;  // > Evolution.simulacija:1
    vz = vz - g * dt;  // > Evolution.simulacija:2
    t = t + dt;  // > Evolution.simulacija:3
    if (z < R) {  // > Evolution.simulacija:4
      dt= 0.0;  // > Evolution.simulacija:5
     // x=0;    // > Evolution.simulacija:6
      console.log("vz=",vz);  // > Evolution.simulacija:7
      console.log("x=",x);  // > Evolution.simulacija:8
      _model.pause();  // > Evolution.simulacija:9
     }  // > Evolution.simulacija:10
        // > Evolution.simulacija:11
    if(navise && vz<=0){  // > Evolution.simulacija:12
      Hmax=z;  // > Evolution.simulacija:13
      dH=H-H0;  // > Evolution.simulacija:14
      navise=false;  // > Evolution.simulacija:15
      HMaxPrikaz=true;  // > Evolution.simulacija:16
      dHPrik=true;  // > Evolution.simulacija:17
     console.log("Dostignuto Hmax"+Hmax+"m");  // > Evolution.simulacija:18
      }  // > Evolution.simulacija:19
  });

  _model.addToFixedRelations(function() { _isPaused = _model.isPaused(); _isPlaying = _model.isPlaying(); });

  _model.addToFixedRelations(function() {
    if (!__pagesEnabled["FixRel Page"]) return;
    H=z;  // > FixedRelations.FixRel Page:1
    //Energije  // > FixedRelations.FixRel Page:2
    Ek=m*vz*vz/2;  // > FixedRelations.FixRel Page:3
    Ep=m*g*H;  // > FixedRelations.FixRel Page:4
    E=Ep+Ek;  // > FixedRelations.FixRel Page:5
  });

