     // > CustomCode.Lib Page:31
  };  // > CustomCode.Lib Page:32
        // > CustomCode.Lib Page:33
        // > CustomCode.Lib Page:34
    responsiveCss=styles;  // > CustomCode.Lib Page:35
    cssPodaci=styles2;  // > CustomCode.Lib Page:36
    // Pronađi pravi DOM element:  // > CustomCode.Lib Page:37
    // wrappedPanel je EJSS ControlElement, a njegova .element  // > CustomCode.Lib Page:38
    // je pravi HTMLDivElement  // > CustomCode.Lib Page:39
