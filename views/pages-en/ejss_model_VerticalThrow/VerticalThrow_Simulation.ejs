  _model.addToInitialization(function() {
    if (!__pagesEnabled["Init Page"]) return;
    Hmax=0;  // > Initialization.Init Page:1
    HMaxPrik=false;  // > Initialization.Init Page:2
    H0Prik=true;  // > Initialization.Init Page:3
    dHPrik=false;  // > Initialization.Init Page:4
    if(H0<R)  // > Initialization.Init Page:5
       H0=R;  // > Initialization.Init Page:6
    HMaxPrikaz=false;  // > Initialization.Init Page:7
    z=H0;  // > Initialization.Init Page:8
    H=H0;  // > Initialization.Init Page:9
    xG=x*razKoo;  // > Initialization.Init Page:10
    yG=y*razKoo;  // > Initialization.Init Page:11
    zG=z*razKoo;  // > Initialization.Init Page:12
    //masa  // > Initialization.Init Page:13
    m=m0;  // > Initialization.Init Page:14
    //Energije  // > Initialization.Init Page:15
    Ek=m*vz*vz/2;  // > Initialization.Init Page:16
    Ep=m*g*H;  // > Initialization.Init Page:17
    E=Ep+Ek;  // > Initialization.Init Page:18
