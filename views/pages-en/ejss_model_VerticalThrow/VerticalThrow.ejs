<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:epub="http://www.idpf.org/2007/ops">
  <head>
   <% include ../../partials/head %>
   <title>Vertical Throw Simulation – Explore Upward Motion Under Gravity</title>
  <meta name="description" content="Interactive simulation of vertical upward motion under gravity. Learn about velocity, displacement, and maximum height through formulas and visualizations. Created using Easy Java Simulations (EJS).">
  <meta name="keywords" content="vertical throw, upward motion, projectile motion, gravity, free fall, initial velocity, maximum height, gravitational acceleration, vertical displacement, physics simulation, Easy Java Simulations, EJS, kinematics, motion equations, vertical motion">
  <link rel="canonical" href="https://kosi-hitac.onrender.com/en/vertical_throw" />

	<meta name="author" content="Slobodan Trsek"/>
    

  </head>
  <body>
 
   <div class="content-wrapper moj-header">
<div class="col-xs-12 col-md-12 col-lg-12">
            <header>
                <% include ../../partials/header %>
            </header>
        </div>
</div>

   
	   <div id="contents_vertical_throw" class="intro_1">
        <div class="intro_1">
		<%- include(path1); %>
      
        </div>
        <div id="introduction_vertical_throw" class="intro_2">
        <%- include(path2); %>

        </div>
      </div>
   
   
   <div class="content">
   <footer>
	
	<% include ../../partials/scripts %>
            <% include ../../partials/footer %>
</footer>
</div>
   
	</div>
	
	<script>
 
  document.addEventListener('DOMContentLoaded', () => {
  const introEl = document.getElementById('introduction_vertical_throw');
  const sadrzaj=document.getElementById('contents_vertical_throw');
  sadrzaj.addEventListener('click', async e => {
    const a = e.target.closest('a[data-id]');
    if (!a) return;
    e.preventDefault();
    
    /* 1) дохвати HTML фрагмент*/
    const resp = await fetch(a.href);
    const html  = await resp.text();
    
    // 2) парсирај у привремени DIV
    const tmp = document.createElement('div');
    tmp.innerHTML = html;
    
    // 3) ишчупај script тагове и премести их у body
    tmp.querySelectorAll('script').forEach(old => {
	  if (old.src && old.src.includes('textresizedetector.js')) return;
      const s = document.createElement('script');
      if (old.src)        s.src = old.src;
      else                 s.textContent = old.textContent;
      document.body.appendChild(s);
    });
    
    // 4) убaci саму симулацију у uvod_vertikalni_hitac
    if (a.dataset.id === 'simulation_vertical_throw') {
      // simulacija: izvuci njen kontejner
      frag = tmp.querySelector('#_topFrame') || tmp.querySelector('#ejs-container');
      introEl.innerHTML = '';
      if (frag) introEl.appendChild(frag);
	  // 5) иницијализуј симулацију одмах
   if (typeof initVerticalThrowSimulation === 'function') {
       initVerticalThrowSimulation();
   }
    } else {
	 if (window._model && typeof window._model.pause === 'function') {
        window._model.pause();        // stop its internal timer
        window._model = null;         // forget it entirely
      }
      // intro stranice: uzmi sav HTML
	  
      introEl.innerHTML = tmp.innerHTML;
    }
	
  });
});
</script>
  </body>
</html>
