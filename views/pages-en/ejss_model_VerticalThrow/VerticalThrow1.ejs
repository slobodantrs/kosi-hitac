<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:epub="http://www.idpf.org/2007/ops">
  <head>
   <% include ../../partials/head %>
   <meta name="description" content="Simulacija vertikalnog hica naviše zajedno sa kratkim uvidom u teoriju vertikalnog hica. 
   Simulacija kreirana pomoću alata Easy Java Simulation(EJS)." />
	<meta name="keywords" content="Vertikalan hitac, kretanje tela, gravitacionom polju zemlje, intenziteta vektora početne brzine, 
	sile teže,slobodno  pada,gravitociono ubrzanje,najvišu tacku putanje,Merenje maksimalne visine,potencijalna energija,
	potencijalna energija pri vertikalnom hicu" />
	<meta name="author" content="Slobodan Trsek"/>
    <title> Početna strana za vertikalan hitac</title>
  </head>
  <body>
  
   <div class="content-wrapper moj-header">
   <% console.log('ulazim u body VericalThrow'); %>
<div class="col-xs-12 col-md-12 col-lg-12">
            <header>
                <% include ../../partials/header %>
            </header>
        </div>
</div>
<div id="contents_vertical_throw" class="content intro_1">
  <div class="intro_1">
  <% console.log('ulazim u partial Contents'); %>
 
	</div>
	<div id="introduction_vertical_throw" class="intro_2">
	
	<% include ./VerticalThrow_Introduction_1 %>

   </div>

   </div>
   
   
   <div class="content">
   <footer>
	
	<% include ../../partials/scripts %>
            <% include ../../partials/footer %>
</footer>
</div>
   
	<script>
 
  document.addEventListener('DOMContentLoaded', () => {
  const introEl = document.getElementById('introduction_vertical_throw');
  const sadrzaj=document.getElementById('contents_vertical_throw');
  sadrzaj.addEventListener('click', async e => {
    const a = e.target.closest('a[data-id]');
    if (!a) return;
    e.preventDefault();
    
    /* 1) дохвати HTML фрагмент*/
    const resp = await fetch(a.href);
    const html  = await resp.text();
    
    // 2) парсирај у привремени DIV
    const tmp = document.createElement('div');
    tmp.innerHTML = html;
    
    // 3) ишчупај script тагове и премести их у body
    tmp.querySelectorAll('script').forEach(old => {
	  if (old.src && old.src.includes('textresizedetector.js')) return;
      const s = document.createElement('script');
      if (old.src)        s.src = old.src;
      else                 s.textContent = old.textContent;
      document.body.appendChild(s);
    });
    
    // 4) убaci саму симулацију у uvod_vertikalni_hitac
    if (a.dataset.id === 'simulation_vertical_throw') {
      // simulacija: izvuci njen kontejner
      frag = tmp.querySelector('#_topFrame') || tmp.querySelector('#ejs-container');
      introEl.innerHTML = '';
      if (frag) introEl.appendChild(frag);
	  // 5) иницијализуј симулацију одмах
   if (typeof initVerticalThrowSimulation === 'function') {
       initinitVerticalThrowSimulation();
   }
    } else {
	 if (window._model && typeof window._model.pause === 'function') {
        window._model.pause();        // stop its internal timer
        window._model = null;         // forget it entirely
      }
      // intro stranice: uzmi sav HTML
	  
      introEl.innerHTML = tmp.innerHTML;
    }
	
  });
});
</script>
  </body>
</html>
