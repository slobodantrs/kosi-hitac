
<!DOCTYPE html>
<html lang="<%= locale %>">
  <head>
  <% include ../../partials/head %>
  <meta name="description" content="Simulation of circular motion of a material point.    Simulation created using the Easy Java Simulation (EJS) tool." />
<meta name="keywords" content="circular motion, uniform circular motion, material point, motion of a material point, normal acceleration, centripetal acceleration, radius of the circle" />
<title> Home Page for Circular Motion </title>

	 <link rel="canonical" href="https://kosi-hitac.onrender.com/en/circular_motion" />
  </head>
  <body>
  <div class="container moj-header">

  
  <div class="content-wrapper moj-header">
   
    <% include ../../partials/header %>


</div>

<div id="contents_circular_motion" class="intro_1">
        <div class="intro_1">
		<%- include(path1); %>
      
        </div>
        <div id="introduction_circular_motion" class="intro_2">
         <%- include(path2); %>
        </div>
      </div>
    
   
<div class="row">
   <div class="col-xs-12 col-md-12 col-lg-12">
   <footer>
	<% include ../../partials/scripts %>
    <% include ../../partials/footer %>
</footer>
</div>
</div>
   
	</div>
	
	
<script>
 
  document.addEventListener('DOMContentLoaded', () => {
  const introEl = document.getElementById('introduction_circular_motion');
  const sadrzaj=document.getElementById('contents_circular_motion');
  sadrzaj.addEventListener('click', async e => {
    const a = e.target.closest('a[data-id]');
    if (!a) return;
    e.preventDefault();
    
    /* 1) дохвати HTML фрагмент*/
    const resp = await fetch(a.href);
    const html  = await resp.text();
    
    // 2) парсирај у привремени DIV
    const tmp = document.createElement('div');
    tmp.innerHTML = html;
    
    // 3) ишчупај script тагове и премести их у body
    tmp.querySelectorAll('script').forEach(old => {
	  if (old.src && old.src.includes('textresizedetector.js')) return;
      const s = document.createElement('script');
      if (old.src)        s.src = old.src;
      else                 s.textContent = old.textContent;
      document.body.appendChild(s);
    });
    
    // 4) убaci саму симулацију у uvod_vertikalni_hitac
    if (a.dataset.id === 'simulation_circular_motion') {
      // simulacija: izvuci njen kontejner
      frag = tmp.querySelector('#_topFrame') || tmp.querySelector('#ejs-container');
      introEl.innerHTML = '';
      if (frag) introEl.appendChild(frag);
	  // 5) иницијализуј симулацију одмах
   if (typeof initCircularMotionSimulation === 'function') {
       initCircularMotionSimulation();
   }
    } else {
	 if (window._model && typeof window._model.pause === 'function') {
        window._model.pause();        // stop its internal timer
        window._model = null;         // forget it entirely
      }
      // intro stranice: uzmi sav HTML
	  
      introEl.innerHTML = tmp.innerHTML;
    }
	
  });
});
</script>

  </body>
</html>
