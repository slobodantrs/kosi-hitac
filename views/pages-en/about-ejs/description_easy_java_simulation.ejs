    <div class="naslov col-xs-12 col-md-12 col-lg-12">
        <h1>About the Easy Java Simulation Tool</h1>
    </div>
    <hr>
</div>

<!--div class="row">
    <p class="col-xs-12 col-md-12 col-lg-12" style="height:300px;text-align: center;">Website under construction...</p>
