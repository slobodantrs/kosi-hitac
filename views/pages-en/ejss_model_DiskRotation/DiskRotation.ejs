<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:epub="http://www.idpf.org/2007/ops">

<head>
<link rel="stylesheet" type="text/css" href="_ejs_library/css/ejss.css"></link>
  <% include ../../partials/head %>
  <link rel="stylesheet"  type="text/css" href="_ejs_library/css/ejss.css" />
<!-- AFTER your bootstrap.css, BEFORE any </head> -->
<link rel="stylesheet" href="/_ejs_library/css/ejss.css" type="text/css" />

  <meta name="description" content="Simulation of the rotation of a rigid body, using a disk rotating around a fixed axis as an example. 
  The simulation was created using the Easy Java Simulation (EJS) tool." />
  <meta name="keywords" content="Rigid body, circular motion, disk rotation, translational motion, rotational motion,
  axis of rotation, angular displacement, angular acceleration, centripetal acceleration, radius" />
  <meta name="author" content="Slobodan Trsek" />

  <title> Home page for Disk Rotation Simulation around its axis</title>
</head>

<body>
  <div class="container moj-header">
    <div class="row">
      <div class="header moj-header content col-xs-12 col-md-12 col-lg-12">
        <% include ../../partials/header %>
      </div>
    </div>
    <div class="row">
      <div id="contents" class="intro_1">
        <div class="intro_1">
          <% include ./DiskRotation_Contents %>
        </div>
        <div id="intro" class="intro_2">
          <% include ./DiskRotation_Intro_1 %>
        </div>
      </div>
    </div>
    <div class="row">
      <div class="content">
        <footer>
          <% include ../../partials/scripts %>
          <% include ../../partials/footer %>
        </footer>
      </div>
    </div>
  </div>
  <script>
  document.addEventListener('DOMContentLoaded', () => {
    const introEl = document.getElementById('intro');
    document.getElementById('contents').addEventListener('click', e => {
      const a = e.target.closest('a[data-id]');
      if (!a) return;
      e.preventDefault();
      fetch(a.href)
        .then(r => r.text())
        .then(html => { introEl.innerHTML = html; })
        .catch(console.error);
    });
  });
</script>
</body>
</html>
