<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:epub="http://www.idpf.org/2007/ops">

<head>

  <% include ../../partials/head %>
  <link rel="stylesheet"  type="text/css" href="/_ejs_library/css/ejss.css" />
  
    <link rel="stylesheet" type="text/css" href="/_ejs_library/css/ejsContentsLeft.css"></link>
    <script src="/_ejs_library/scripts/common_script.js"></script>
    <script src="/_ejs_library/scripts/textresizedetector.js"></script>
    <script src="/_ejs_library/ejsS.v1.min.js"></script>
<!-- AFTER your bootstrap.css, BEFORE any </head> -->


  <meta name="description" content="Simulation of the rotation of a rigid body, using a disk rotating around a fixed axis as an example. 
  The simulation was created using the Easy Java Simulation (EJS) tool." />
  <meta name="keywords" content="Rigid body, circular motion, disk rotation, translational motion, rotational motion,
  axis of rotation, angular displacement, angular acceleration, centripetal acceleration, radius" />
  <meta name="author" content="Slobodan Trsek" />
 <link rel="stylesheet" href="/_ejs_library/css/ejss.css" type="text/css" />
  <title> Home page for Disk Rotation Simulation around its axis</title>
</head>

<body>
  <div class="container moj-header">
    <div class="row">
      <div class="header moj-header content ">
        <% include ../../partials/header %>
      </div>
    </div>
    <div class="row">
      <div id="contents" class="intro_1">
        <div class="intro_1">
          <% include ./DiskRotation_Contents %>
        </div>
        <div id="intro" class="intro_2">
          <% include ./DiskRotation_Intro_1 %>
        </div>
      </div>
    </div>
    <div class="row">
      <div class="content">
        <footer>
          <% include ../../partials/scripts %>
          <% include ../../partials/footer %>
        </footer>
      </div>
    </div>
  </div>
  <script>
 
  document.addEventListener('DOMContentLoaded', () => {
  const introEl = document.getElementById('intro');
  document.getElementById('contents').addEventListener('click', async e => {
    const a = e.target.closest('a[data-id]');
    if (!a) return;
    e.preventDefault();
    
    // 1) дохвати HTML фрагмент
    const resp = await fetch(a.href);
    const html  = await resp.text();
    
    // 2) парсирај у привремени DIV
    const tmp = document.createElement('div');
    tmp.innerHTML = html;
    
    // 3) ишчупај <script> тагове и премести их у body
    tmp.querySelectorAll('script').forEach(old => {
      const s = document.createElement('script');
      if (old.src)        s.src = old.src;
      else                 s.textContent = old.textContent;
      document.body.appendChild(s);
    });
    
    // 4) убaci саму симулацију у intro
    const frag = tmp.querySelector('#ejs-container');
    introEl.innerHTML = '';
    if (frag) introEl.appendChild(frag);
  });
});

</script>
</body>
</html>
