<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:epub="http://www.idpf.org/2007/ops">

<head>

  <% include ../../partials/head %>
 
   
<!-- AFTER your bootstrap.css, BEFORE any </head> -->

<link rel="canonical" href="https://kosi-hitac.onrender.com/en/disk_rotation" />
<title>Disk Rotation Simulation – Rigid Body Circular Motion</title>

  <meta name="author" content="Slobodan Trsek" />

  
</head>

<body>
  <div class="container moj-header">
    <div class="row">
      <div class="header moj-header content ">
        <% include ../../partials/header %>
      </div>
    </div>
	
      <div id="contents_disk_rotation" class="intro_1">
        <div class="intro_1">
		<%- include(path1); %>
      
        </div>
        <div id="introduction_disk_rotation" class="">
        <%- include(path2); %>

        </div>
      </div>
	
	
    <div class="row">
      <div class="content">
        <footer>
          <% include ../../partials/scripts %>
          <% include ../../partials/footer %>
        </footer>
      </div>
    </div>
  </div>
  <script>
 
  document.addEventListener('DOMContentLoaded', () => {
  const introEl = document.getElementById('introduction_disk_rotation');
  document.getElementById('contents_disk_rotation').addEventListener('click', async e => {
    const a = e.target.closest('a[data-id]');
    if (!a) return;
    e.preventDefault();
    
    // 1) дохвати HTML фрагмент
    const resp = await fetch(a.href);
    const html  = await resp.text();
    
    // 2) парсирај у привремени DIV
    const tmp = document.createElement('div');
    tmp.innerHTML = html;
    
    // 3) ишчупај <script> тагове и премести их у body
    tmp.querySelectorAll('script').forEach(old => {
	  if (old.src && old.src.includes('textresizedetector.js')) return;
      const s = document.createElement('script');
      if (old.src)        s.src = old.src;
      else                 s.textContent = old.textContent;
      document.body.appendChild(s);
    });
    
    // 4) убaci саму симулацију у intro
    if (a.dataset.id === 'simulation_disk_rotation') {
      // simulacija: izvuci njen kontejner
      frag = tmp.querySelector('#_topFrame') || tmp.querySelector('#ejs-container');
      introEl.innerHTML = '';
      if (frag) introEl.appendChild(frag);
	  // 5) иницијализуј симулацију одмах
   if (typeof initDiskRotationSimulation === 'function') {
       initDiskRotationSimulation();
   }
    } else {
	 if (window._model && typeof window._model.pause === 'function') {
        window._model.pause();        // stop its internal timer
        window._model = null;         // forget it entirely
      }
      // intro stranice: uzmi sav HTML
      introEl.innerHTML = tmp.innerHTML;
    }
	
  });
});

</script>
</body>
</html>
