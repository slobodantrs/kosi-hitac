<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:epub="http://www.idpf.org/2007/ops">
  <head>
  <% include ../../partials/head %>
  <title>Ravno kretanje krutog tela – Simulacija i objašnjenje</title>
  <meta name="description" content="Interaktivna simulacija ravnog kretanja krutog tela, uključujući kotrljanje bez klizanja, trenutni pol brzina i ubrzanje tačaka. Vizualizacija pomoću Easy Java Simulation (EJS)." />
  <meta name="keywords" content="ravno kretanje, kruto telo, kotrljanje bez klizanja, trenutni pol brzina, ubrzanje, simulacija, EJS, fizika, mehanika" />
  
  <link rel="canonical" href="https://kosi-hitac.onrender.com/ravno_kretanje" />
     <meta name="author" content="kosi-hitac.onrender.com" />
  <meta name="robots" content="index, follow" />
  </head>
  <body>
  <div class="container moj-header">

  <div class="content-wrapper moj-header">
   
    <% include ../../partials/header %>
	</div>
	
	
 <div id="contents_ravno_kretanje" class="intro_1">
        <div class="intro_1">
		<%- include(path1); %>
      
        </div>
        <div id="uvod_ravno_kretanje" class="">
        <%- include(path2); %>

        </div>
      </div>
   
   
    <div class="content">
   <footer>
	<% include ../../partials/scripts %>
    <% include ../../partials/footer %>
</footer>
</div>

    </div>
	
	<script>
 
  document.addEventListener('DOMContentLoaded', () => {
  const introEl = document.getElementById('uvod_ravno_kretanje');
  document.getElementById('contents_ravno_kretanje').addEventListener('click', async e => {
    const a = e.target.closest('a[data-id]');
    if (!a) return;
    e.preventDefault();
    
    /* 1) дохвати HTML фрагмент*/
    const resp = await fetch(a.href);
    const html  = await resp.text();
    
    // 2) парсирај у привремени DIV
    const tmp = document.createElement('div');
    tmp.innerHTML = html;
    
    // 3) ишчупај script тагове и премести их у body
    tmp.querySelectorAll('script').forEach(old => {
	  if (old.src && old.src.includes('textresizedetector.js')) return;
      const s = document.createElement('script');
      if (old.src)        s.src = old.src;
      else                 s.textContent = old.textContent;
      document.body.appendChild(s);
    });
    
    // 4) убaci саму симулацију у uvod_slobodan_pad
    if (a.dataset.id === 'simulacija_ravno_kretanje') {
      // simulacija: izvuci njen kontejner
      frag = tmp.querySelector('#_topFrame') || tmp.querySelector('#ejs-container');
      introEl.innerHTML = '';
      if (frag) introEl.appendChild(frag);
	  // 5) иницијализуј симулацију одмах
   if (typeof initRavnoKretanjeSimulation === 'function') {
       initRavnoKretanjeSimulation();
   }
    } else {
	 if (window._model && typeof window._model.pause === 'function') {
        window._model.pause();        // stop its internal timer
        window._model = null;         // forget it entirely
      }
      // intro stranice: uzmi sav HTML
	  
      introEl.innerHTML = tmp.innerHTML;
    }
	
  });
});

</script>
  </body>
</html>
