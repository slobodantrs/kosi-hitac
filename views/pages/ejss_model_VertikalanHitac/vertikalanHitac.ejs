<!DOCTYPE html>
<html lang="<%= locale %>" xmlns="http://www.w3.org/1999/xhtml">
  <head>
    <% include ../../partials/head %>
    <meta name="description" content="Simulacija vertikalnog hica …" />
    <meta name="keywords" content="Vertikalan hitac, …" />
    <meta name="author" content="Slobodan"/>
    <title>Početna strana za vertikalan hitac</title>
  </head>
  <body>

    <!-- logovanje iz EJS promenljive u browser konzolu -->
    <script>
      var path1 = "<%= path1 %>";
      console.log('path1 u vertikalniHitac.ejs =', path1);
    </script>

    <div class="content-wrapper moj-header">
      <div class="col-xs-12 col-md-12 col-lg-12">
        <header>
          <% include ../../partials/header %>
        </header>
      </div>
    </div>

    
	 <div class="row">
      <div id="contents_vertikalni_hitac" class="intro_1">
        <div class="intro_1">
          <% include ./VertikalanHitac_Contents %>
        </div>
        <div id="uvod_vertikalni_hitac" class="intro_2">
          <% include ./VertikalanHitac_Intro_1 %>
        </div>
      </div>
    </div>
  

    <div class="content">
      <footer>
        <% include ../../partials/scripts %>
    <% include ../../partials/footer %>
      </footer>
    </div>


<script>
 
  document.addEventListener('DOMContentLoaded', () => {
  const introEl = document.getElementById('uvod_vertikalan_hitac');
  document.getElementById('contents_vertikalan_hitac').addEventListener('click', async e => {
    const a = e.target.closest('a[data-id]');
    if (!a) return;
    e.preventDefault();
    
    /* 1) дохвати HTML фрагмент*/
    const resp = await fetch(a.href);
    const html  = await resp.text();
    
    // 2) парсирај у привремени DIV
    const tmp = document.createElement('div');
    tmp.innerHTML = html;
    
    // 3) ишчупај script тагове и премести их у body
    tmp.querySelectorAll('script').forEach(old => {
	  if (old.src && old.src.includes('textresizedetector.js')) return;
      const s = document.createElement('script');
      if (old.src)        s.src = old.src;
      else                 s.textContent = old.textContent;
      document.body.appendChild(s);
    });
    
    // 4) убaci саму симулацију у uvod_vertikalni_hitac
    if (a.dataset.id === 'simulacija_vertikalni_hitac') {
      // simulacija: izvuci njen kontejner
      frag = tmp.querySelector('#_topFrame') || tmp.querySelector('#ejs-container');
      introEl.innerHTML = '';
      if (frag) introEl.appendChild(frag);
	  // 5) иницијализуј симулацију одмах
   if (typeof initVertikalniHitacSimulation === 'function') {
       initVertikalniHitacSimulation();
   }
    } else {
	 if (window._model && typeof window._model.pause === 'function') {
        window._model.pause();        // stop its internal timer
        window._model = null;         // forget it entirely
      }
      // intro stranice: uzmi sav HTML
	  
      introEl.innerHTML = tmp.innerHTML;
    }
	
  });
});

  </body>
</html>
