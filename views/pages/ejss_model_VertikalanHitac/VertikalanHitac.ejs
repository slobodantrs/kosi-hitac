<!DOCTYPE html>
<html lang="<%= locale %>" xmlns="http://www.w3.org/1999/xhtml">
<% console.log("Vertikalan hitac.ejs, path1:"+path1+", path2: "+path2); %>
  <head>
    <% include ../../partials/head %>
	<link rel="canonical" href="https://kosi-hitac.onrender.com/vertikalan_hitac" />
<meta name="description" content="Interaktivna simulacija vertikalnog hica i slobodnog pada: istražite kretanje tela pod uticajem gravitacije, analizirajte brzinu, ubrzanje, visinu i energiju. Idealno za učenike i nastavnike fizike." />
<meta name="keywords" content="vertikalan hitac, slobodan pad, kretanje tela, gravitacija, fizika, simulacija, brzina, ubrzanje, visina, obrazovanje, interaktivna simulacija, energija, potencijalna energija, kinetička energija, parabolično kretanje, EJS, Easy Java Simulations" />


    <meta name="author" content="Slobodan Tršek"/>
    <title>Početna strana za vertikalan hitac</title>
  </head>
  <body>

   

    <div class="content-wrapper moj-header">
    
        <header>
          <% include ../../partials/header %>
        </header>
      
    </div>

    

      <div id="contents_vertikalni_hitac" class="intro_1">
        <div class="intro_1">
		<%- include(path1); %>
      
        </div>
        <div id="uvod_vertikalni_hitac" class="intro_2">
         <%- include(path2); %>
        </div>
      </div>
    

    <div class="content">
      <footer>
        <% include ../../partials/scripts %>
    <% include ../../partials/footer %>
      </footer>
    </div>


<script>
 
  document.addEventListener('DOMContentLoaded', () => {
  const introEl = document.getElementById('uvod_vertikalni_hitac');
  const sadrzaj=document.getElementById('contents_vertikalni_hitac');
  sadrzaj.addEventListener('click', async e => {
    const a = e.target.closest('a[data-id]');
    if (!a) return;
    e.preventDefault();
    
    /* 1) дохвати HTML фрагмент*/
    const resp = await fetch(a.href);
    const html  = await resp.text();
    
    // 2) парсирај у привремени DIV
    const tmp = document.createElement('div');
    tmp.innerHTML = html;
    
    // 3) ишчупај script тагове и премести их у body
    tmp.querySelectorAll('script').forEach(old => {
	  if (old.src && old.src.includes('textresizedetector.js')) return;
      const s = document.createElement('script');
      if (old.src)        s.src = old.src;
      else                 s.textContent = old.textContent;
      document.body.appendChild(s);
    });
    const id = a.dataset.id;
    // 4) убaci саму симулацију у uvod_vertikalni_hitac
    if (id === 'simulacija_vertikalan_hitac' || id === 'simulacija_slobodnog_pada') {
      // simulacija: izvuci njen kontejner
      frag = tmp.querySelector('#_topFrame') || tmp.querySelector('#ejs-container');
      introEl.innerHTML = '';
      if (frag) introEl.appendChild(frag);
	  // 5) иницијализуј симулацију одмах
   if (id === 'simulacija_vertikalan_hitac' && typeof initVertikalanHitacSimulation === 'function') {
       initVertikalanHitacSimulation();
   }
   else if (id === 'simulacija_slobodnog_pada' && typeof initSlobodanPadSimulation === 'function') {
       initSlobodanPadSimulation();
   }
    } else {
	 if (window._model && typeof window._model.pause === 'function') {
        window._model.pause();        // stop its internal timer
        window._model = null;         // forget it entirely
      }
      // intro stranice: uzmi sav HTML
	  
      introEl.innerHTML = tmp.innerHTML;
    }
	
  });
});
</script>
  </body>
</html>
