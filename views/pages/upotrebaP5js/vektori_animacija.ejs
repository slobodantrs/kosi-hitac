 <script>
  document.addEventListener('DOMContentLoaded', () => {
    const iframe = document.getElementById('tutorial-video');

    // Prag širine ispod kojeg smatramo da je mobilni uređaj
    const mobileBreakpoint = 768;

    // URL-ovi za desktop i mobilni
    const desktopVideo = 'https://www.youtube.com/embed/0FUnZs3C6n8';
    const mobileVideo  = 'https://www.youtube.com/embed/D6T1mpE1jVg';

    // Ako je width manje od praga, prikaži mobilnu verziju
    if (window.innerWidth <= mobileBreakpoint) {
      iframe.src = mobileVideo;
    } else {
      iframe.src = desktopVideo;
    }

    // (opciono) osveži pri resize-u ekrana
    window.addEventListener('resize', () => {
      const isMobile = window.innerWidth <= mobileBreakpoint;
      iframe.src = isMobile ? mobileVideo : desktopVideo;
    });
  });
</script>

<script>
  // 1) define your “sketch” as a function that takes a p5 instance `p`
  function sketch1(p) {
    let vectors = [];
    let dragging = null;

    p.setup = function() {
      p.createCanvas(600, 400).parent('sketch-holder');
      // generate two random vectors
      for (let i = 0; i < 2; i++) {
        vectors.push({
          vx: p.random(-80, 80),
          vy: p.random(-80, 80),
          col: i === 0 ? '#e63946' : '#2a9d8f'
        });
      }
    };

    p.draw = function() {
      p.background(240);
      p.stroke(50);
      // draw axes
      p.line(p.width/2, 0, p.width/2, p.height);
      p.line(0, p.height/2, p.width, p.height/2);
      p.noStroke();

      // render and interact with each vector
      vectors.forEach(v => drawVector(p, v));
    };

    p.mousePressed = function() {
      const mx = p.mouseX - p.width/2;
      const my = -(p.mouseY - p.height/2);
      for (let v of vectors) {
        if (p.dist(mx, my, v.vx, v.vy) < 10) {
          dragging = v;
          break;
        }
      }
    };

    p.mouseDragged = function() {
      if (dragging) {
        dragging.vx = p.mouseX - p.width/2;
        dragging.vy = -(p.mouseY - p.height/2);
      }
    };

    p.mouseReleased = function() {
      dragging = null;
    };

    // helper to draw one vector
    function drawVector(p, v) {
      p.push();
        p.translate(p.width/2, p.height/2);
        p.stroke(v.col);
        p.strokeWeight(3);
        p.line(0, 0, v.vx, -v.vy);

        // arrowhead
        p.push();
          p.translate(v.vx, -v.vy);
          p.rotate(-p.atan2(v.vy, v.vx));
          p.fill(v.col);
          p.noStroke();
          p.triangle(0, 0, -10, 5, -10, -5);
        p.pop();

        // draggable handle
        p.noStroke();
        p.fill(v.col);
        p.ellipse(v.vx, -v.vy, 12);
      p.pop();
    }
  }

  // 2) instantiate *that* sketch inside your container
  new p5(sketch1, 'sketch-holder');
</script>

  <script language="javascript" type="text/javascript" src="js/p5js/VektoriOperacije/vektori_operacije.js"></script>
