&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="crna">widthS</span>  = <span class="narandzasta">2</span> * <span class="crna">displayWidth</span> * <span class="narandzasta">3</span>;<br>
&nbsp;&nbsp;&nbsp;&nbsp;} <span class="plava">else</span> <span class="plava">if</span> (<span class="crna">displayWidth</span> &lt; <span class="crna">displayHeight</span>) {<br>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="crna">widthS</span>  = <span class="crna">displayWidth</span>;<br>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="crna">heightS</span> = <span class="narandzasta">2</span> * <span class="crna">widthS</span> / <span class="narandzasta">3</span>;<br>
&nbsp;&nbsp;&nbsp;&nbsp;} <span class="plava">else</span> {<br>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="crna">widthS</span>  = <span class="narandzasta">2</span> * <span class="crna">displayWidth</span> / <span class="narandzasta">3</span>;<br>
&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="crna">heightS</span> = <span class="narandzasta">2</span> * <span class="crna">widthS</span> / <span class="narandzasta">3</span>;<br>
