&nbsp;&nbsp;<span class="zelena">orbitControl</span>(); <span class="siva">// interaktivno upravljanje kamerom mišem/tačom</span><br>
&nbsp;&nbsp;<span class="zelena">rotateX</span>(<span class="narandzasta">10</span>*<span class="crvena">PI</span>/<span class="narandzasta">24</span>);<br>
&nbsp;&nbsp;<span class="zelena">rotateY</span>(<span class="crvena">PI</span>/<span class="narandzasta">64</span>);<br>
<br>
&nbsp;&nbsp;// ažuriraj položaje svih tela pre iscrtavanja<br>
