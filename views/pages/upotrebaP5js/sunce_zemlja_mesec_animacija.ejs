&nbsp;&nbsp;<span class="plava">else</span> <span class="plava">if</span> (<span class="crzelaena">key</span> == <span class="crvena">"ArrowLeft"</span>) { <span class="crna">z</span> -= <span class="narandzasta">1</span>; }<br>
}<br>
