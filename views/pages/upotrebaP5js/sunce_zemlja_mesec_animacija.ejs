}<br>
<br>
<span class="plava">class</span> <span class="zelena">Planeta</span> {<br>
&nbsp;&nbsp;<span class="plava">constructor</span>(<span class="crna">radius</span>, <span class="crna">distance</span>, <span class="crna">parent</span>, <span class="crna">texture</span>, <span class="crna">speedRotation</span>, <span class="crna">speedOwnRotation</span>, <span class="crna">emission</span>) {<br>
&nbsp;&nbsp;&nbsp;&nbsp;// postavi osnovne parametre tela<br>
&nbsp;&nbsp;&nbsp;&nbsp;<span class="crna">this</span>.<span class="crna">radius</span> = <span class="crna">radius</span>;<br>
&nbsp;&nbsp;&nbsp;&nbsp;<span class="crna">this</span>.<span class="crna">distance</span> = <span class="crna">distance</span>;<br>
