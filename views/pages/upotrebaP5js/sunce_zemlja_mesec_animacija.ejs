&nbsp;&nbsp;&nbsp;&nbsp;<span class="crna">heightS</span> = <span class="narandzasta">2</span> * <span class="crna">widthS</span> / <span class="narandzasta">3</span>;<br>
&nbsp;&nbsp;}<br>
&nbsp;&nbsp;// ograničenje maksimalne širine radi održavanja proporcija<br>
&nbsp;&nbsp;<span class="plava">if</span> (<span class="crna">widthS</span> &gt; <span class="narandzasta">940</span>) {<br>
&nbsp;&nbsp;&nbsp;&nbsp;<span class="crna">widthS</span>  = <span class="narandzasta">940</span>;<br>
&nbsp;&nbsp;&nbsp;&nbsp;<span class="crna">heightS</span> = <span class="narandzasta">627</span>;<br>
&nbsp;&nbsp;}<br>
}<br>
<br>
<span class="plava">function</span> <span class="zelena">windowResized</span>() {<br>
&nbsp;&nbsp;<span class="zelena">determineSize</span>(); <span class="siva">// ponovo preračunaj dimenzije</span><br>
