<span class="plava">var</span> <span class="crna">canvasDrawing</span>; <span class="siva">// gl platno za crtanje 3D scene</span><br>
<span class="plava">let</span> <span class="crna">container</span>, <span class="crna">containerMain</span>; <span class="siva">// HTML elementi za smeštaj canvasa</span><br>
<span class="plava">var</span> <span class="crna">isMobile</span>; <span class="siva">// da li je uređaj mobilni (orientacija != undefined)</span><br>
<span class="plava">var</span> <span class="crna">widthS</span>;<br>
<span class="plava">var</span> <span class="crna">heightS</span>;<br>
<span class="plava">let</span> <span class="crna">sun</span>;          <span class="siva">// glavni objekat - Sunce</span><br>
<span class="plava">let</span> <span class="crna">prevMouse</span>;   <span class="siva">// prethodna pozicija miša (prilikom pritiska)</span><br>
<span class="plava">let</span> <span class="crna">zoom</span> = <span class="narandzasta">1</span>;   <span class="siva">// faktor zumiranja scene</span><br>
<span class="plava">let</span> <span class="crna">drag</span>;        <span class="siva">// vektor za pomeranje svetla</span><br>
