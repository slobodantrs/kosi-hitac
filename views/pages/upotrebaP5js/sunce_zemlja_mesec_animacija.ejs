&nbsp;&nbsp;&nbsp;&nbsp;<span class="zelena">camera</span>(<span class="narandzasta">0</span>,<span class="narandzasta">0</span>,-<span class="narandzasta">300</span>,<span class="narandzasta">0</span>,<span class="narandzasta">0</span>,<span class="narandzasta">0</span>,<span class="narandzasta">0</span>,-<span class="narandzasta">1</span>,<span class="narandzasta">0</span>);<br>
&nbsp;&nbsp;&nbsp;&nbsp;<span class="zelena">image</span>(<span class="crna">spaceIm</span>,<span class="narandzasta">0</span>,<span class="narandzasta">0</span>,<span class="narandzasta">1.5</span>*<span class="crna">widthS</span>,<span class="narandzasta">1.5</span>*<span class="crna">heightS</span>);<br>
