&nbsp;&nbsp;<span class="crna">sun</span>.<span class="zelena">show</span>();<br>
}<br>
<br>
<span class="plava">function</span> <span class="zelena">mousePressed</span>() {<br>
&nbsp;&nbsp;// pamti poziciju miša pri kliku za kasnija svetlosna podešavanja<br>
