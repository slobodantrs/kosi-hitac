}<br>
<br>
<span class="plava">function</span> <span class="zelena">draw</span>() {<br>
&nbsp;&nbsp;// postavi pozadinu svemira i očisti Z-bufer pre 3D crtanja<br>
&nbsp;&nbsp;<span class="crna">spaceIm</span>.<span class="zelena">resize</span>(<span class="crna">widthS</span>, <span class="crna">heightS</span>);<br>
&nbsp;&nbsp;<span class="zelena">imageMode</span>(<span class="crvena">CENTER</span>);<br>
