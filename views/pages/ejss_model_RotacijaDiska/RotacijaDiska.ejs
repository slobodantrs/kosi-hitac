<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE html>
<html lang="<%= locale %>" xmlns="http://www.w3.org/1999/xhtml" xmlns:epub="http://www.idpf.org/2007/ops">


  <head>
  <% include ../../partials/head %>
 
	<link rel="canonical" href="https://kosi-hitac.onrender.com/rotacija_diska" />

<meta name="description" content="Interaktivna simulacija rotacije diska oko fiksne ose. Upoznajte se sa konceptima kao što su moment sile, moment inercije, ugaona brzina, centripetalno ubrzanje i zakon održanja momenta impulsa kroz vizuelne prikaze i objašnjenja." />

<meta name="keywords" content="rotacija diska, kruto telo, kružno kretanje, moment inercije, ugaona brzina, centripetalno ubrzanje, moment sile, zakon održanja momenta impulsa, rotaciona dinamika, simulacija fizike, EJS, p5.js" />


	<meta name="author" content="Slobodan Trsek"/>
    
    <title> Početna strana za simulaciju Rotacije Diska oko svoje ose</title>
  </head>
  <body>
  <div class="container moj-header">
  
  <div class="content-wrapper moj-header">
   
    <% include ../../partials/header %>

</div>

 
   
  <div id="contents_rotacija_diska" class="intro_1">
        <div class="intro_1">
		<%- include(path1); %>
      
        </div>
        <div id="uvod_rotacija_diska" class="">
        <%- include(path2); %>

        </div>
      </div>
   
  
   <div class="content">
   <footer>
	<% include ../../partials/scripts %>
    <% include ../../partials/footer %>
</footer>
</div>
</div>
   
	
	 <script>
 
  document.addEventListener('DOMContentLoaded', () => {
  // Sad element već treba da postoji (ili ga dinamički kreiraj)
    const introEl = document.getElementById('uvod_rotacija_diska');
    if (!introEl) {
      console.warn('Container #uvod_rotacija_diska not found in DOM');
      return;
    }
  document.getElementById('contents_rotacija_diska').addEventListener('click', async e => {
    const a = e.target.closest('a[data-id]');
    if (!a) return;
    e.preventDefault();
    
    // 1) дохвати HTML фрагмент
    const resp = await fetch(a.href);
    const html  = await resp.text();
    
    // 2) парсирај у привремени DIV
    const tmp = document.createElement('div');
    tmp.innerHTML = html;
    
    // 3) ишчупај script тагове и премести их у body
    tmp.querySelectorAll('script').forEach(old => {
	  if (old.src && old.src.includes('textresizedetector.js')) return;
      const s = document.createElement('script');
      if (old.src)        s.src = old.src;
      else                 s.textContent = old.textContent;
      document.body.appendChild(s);
    });
    
    // 4) убaci саму симулацију у uvod_rotacija
    if (a.dataset.id === 'simulacija_rotacija_diska') {
      // simulacija: izvuci njen kontejner
      frag = tmp.querySelector('#_topFrame') || tmp.querySelector('#ejs-container');
      introEl.innerHTML = '';
      if (frag) introEl.appendChild(frag);
	  // 5) иницијализуј симулацију одмах
   if (typeof initRotacijaDiskaSimulation === 'function') {
       initRotacijaDiskaSimulation();
   }
    } else {
	 if (window._model && typeof window._model.pause === 'function') {
        window._model.pause();        // stop its internal timer
        window._model = null;         // forget it entirely
      }
      // intro stranice: uzmi sav HTML
	  
      introEl.innerHTML = tmp.innerHTML;
    }
	
  });
});

</script>
  </body>
</html>
