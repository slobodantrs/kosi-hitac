  function odrediDometIHMax () {  // > CustomCode.odrediDometIHMax:1
    console.log("function odrediDometIHMax()");  // > CustomCode.odrediDometIHMax:2
    _model.D=x;  // > CustomCode.odrediDometIHMax:3
    console.log("x="+x);  // > CustomCode.odrediDometIHMax:4
    console.log("D="+_model.D);  // > CustomCode.odrediDometIHMax:5
    prikazHMax=true;  // > CustomCode.odrediDometIHMax:6
    _view._update();  // > CustomCode.odrediDometIHMax:7
      // > CustomCode.odrediDometIHMax:8
  }  // > CustomCode.odrediDometIHMax:9
  // ova promenljiva sada postaje globalna  // > CustomCode.odrediDometIHMax:10
  function updateStyle() {  // > CustomCode.odrediDometIHMax:11
    console.log("function updateStyle()");  // > CustomCode.odrediDometIHMax:12
    // Sakupi svoj CSS u objekat umesto stringa  // > CustomCode.odrediDometIHMax:13
    var isMobile = window.innerWidth < 768;  // > CustomCode.odrediDometIHMax:14
      // > CustomCode.odrediDometIHMax:15
    var styles = {  // > CustomCode.odrediDometIHMax:16
      display: 'flex',  // > CustomCode.odrediDometIHMax:17
      gap: '8px',  // > CustomCode.odrediDometIHMax:18
      flexDirection: isMobile ? 'column' : 'row'  // > CustomCode.odrediDometIHMax:19
    };  // > CustomCode.odrediDometIHMax:20
    var styles2={  // > CustomCode.odrediDometIHMax:21
    "display": "flex",  // > CustomCode.odrediDometIHMax:22
    "margin": "0px",  // > CustomCode.odrediDometIHMax:23
    "vertical-align": "center",  // > CustomCode.odrediDometIHMax:24
    "gap": "8px",  // > CustomCode.odrediDometIHMax:25
    "flex-direction": isMobile ? 'row' : 'column',  // > CustomCode.odrediDometIHMax:26
    "justify-content": "flex-start",  // > CustomCode.odrediDometIHMax:27
    "align-items": "flex-start",  // > CustomCode.odrediDometIHMax:28
    "flex-wrap": "wrap"  // > CustomCode.odrediDometIHMax:29
  };  // > CustomCode.odrediDometIHMax:30
        // > CustomCode.odrediDometIHMax:31
        // > CustomCode.odrediDometIHMax:32
    responsiveCss=styles;  // > CustomCode.odrediDometIHMax:33
    cssPodaci=styles2;  // > CustomCode.odrediDometIHMax:34
    // Pronađi pravi DOM element:  // > CustomCode.odrediDometIHMax:35
    // wrappedPanel je EJSS ControlElement, a njegova .element  // > CustomCode.odrediDometIHMax:36
    // je pravi HTMLDivElement  // > CustomCode.odrediDometIHMax:37
    var panelDom = _view.wrappedPanel;  // > CustomCode.odrediDometIHMax:38
    if (panelDom) {  // > CustomCode.odrediDometIHMax:39
      // Postavi inline style  // > CustomCode.odrediDometIHMax:40
       // > CustomCode.odrediDometIHMax:41
      Object.assign(panelDom.getStyle(), styles);       // > CustomCode.odrediDometIHMax:42
          // > CustomCode.odrediDometIHMax:43
      console.log("Applied styles:", styles);  // > CustomCode.odrediDometIHMax:44
    } else {  // > CustomCode.odrediDometIHMax:45
      console.warn("wrappedPanel.element nije dostupan");  // > CustomCode.odrediDometIHMax:46
    }  // > CustomCode.odrediDometIHMax:47
  }  // > CustomCode.odrediDometIHMax:48
  // ovde pozovemo updateStyle i primenimo ga  // > CustomCode.odrediDometIHMax:49
  function __viewReady() {  // > CustomCode.odrediDometIHMax:50
    updateStyle();  // > CustomCode.odrediDometIHMax:51
    // baci listener za resize  // > CustomCode.odrediDometIHMax:52
    window.addEventListener('resize', updateStyle);  // > CustomCode.odrediDometIHMax:53
  }  // > CustomCode.odrediDometIHMax:54

  _model.addToInitialization(function() {
    if (!__pagesEnabled["inicijalizacija"]) return;
    y=H;  // > Initialization.inicijalizacija:1
    v=v0;  // > Initialization.inicijalizacija:2
    theta=thetaDeg*Math.PI/180;  // > Initialization.inicijalizacija:3
    thetaPoc=theta;  // > Initialization.inicijalizacija:4
    vx =  v* Math.cos(theta);  // > Initialization.inicijalizacija:5
    vy = v * Math.sin(theta);  // > Initialization.inicijalizacija:6
    v0x=vx;  // > Initialization.inicijalizacija:7
    v0y=vy;  // > Initialization.inicijalizacija:8
    xv = x //+ v* Math.cos(theta);  // > Initialization.inicijalizacija:9
    yv = y //+ v * Math.sin(theta);  // > Initialization.inicijalizacija:10
    D=0;  // > Initialization.inicijalizacija:11
    navise=true;  // > Initialization.inicijalizacija:12
    prikazHMax=false;  // > Initialization.inicijalizacija:13
    updateStyle();  // > Initialization.inicijalizacija:14
    window.addEventListener("resize", updateStyle);  // > Initialization.inicijalizacija:15
    kraj=false;  // > Initialization.inicijalizacija:16
    //D=v0*v0*Math.sin(2*theta)/g  // > Initialization.inicijalizacija:17
    HMaxRac=H+v0y*v0y/(2*g);  // > Initialization.inicijalizacija:18
    tP=(v0y/g)+Math.sqrt(v0y*v0y+2*g*H)/g;  // > Initialization.inicijalizacija:19
    D=v0x*tP;  // > Initialization.inicijalizacija:20
  });

  _model.addToEvolution(function() {
    if (!__pagesEnabled["evolucija"]) return;
    _view._update();  // > Evolution.evolucija:1
    vy = vy - g * dt;  // > Evolution.evolucija:2
    x = x + vx * dt;  // > Evolution.evolucija:3
    y = y + vy * dt - 0.5 * g * dt * dt;  // > Evolution.evolucija:4
    t = t + dt;  // > Evolution.evolucija:5
    v = Math.sqrt(vx*vx + vy*vy);  // > Evolution.evolucija:6
    theta = Math.atan2(vy, vx);  // > Evolution.evolucija:7
    if (y <= 0)   // > Evolution.evolucija:8
    {  // > Evolution.evolucija:9
      _model.D=x;  // > Evolution.evolucija:10
      odrediDometIHMax();  // > Evolution.evolucija:11
      _view._update();  // > Evolution.evolucija:12
        // > Evolution.evolucija:13
      if(!kraj){  // > Evolution.evolucija:14
        kraj=true;  // > Evolution.evolucija:15
        }  // > Evolution.evolucija:16
    }  // > Evolution.evolucija:17
    if(navise && vy<0){  // > Evolution.evolucija:18
      HMax=y;  // > Evolution.evolucija:19
      console.log("vy="+vy);  // > Evolution.evolucija:20
      navise=false;  // > Evolution.evolucija:21
    }  // > Evolution.evolucija:22
    if(_model.isPaused())  // > Evolution.evolucija:23
    console.log("Pauza");  // > Evolution.evolucija:24
         // > Evolution.evolucija:25
  });

  _model.addToFixedRelations(function() { _isPaused = _model.isPaused(); _isPlaying = _model.isPlaying(); });

  _model.addToFixedRelations(function() {
    if (!__pagesEnabled["vektorBrzine"]) return;
    if(kraj){  // > FixedRelations.vektorBrzine:1
      _model._pause();  // > FixedRelations.vektorBrzine:2
      }  // > FixedRelations.vektorBrzine:3
  });

  _model.addToFixedRelations(function() { _isPaused = _model.isPaused(); _isPlaying = _model.isPlaying(); });

    _model._fontResized = function(iBase,iSize,iDelta) {
