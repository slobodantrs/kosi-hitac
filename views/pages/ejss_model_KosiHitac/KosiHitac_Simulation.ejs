    v0x = 0; // EjsS Model.Variables.promenljjive.v0x
    v0y = 0; // EjsS Model.Variables.promenljjive.v0y
    theta = 0; // EjsS Model.Variables.promenljjive.theta
    t = 0.0; // EjsS Model.Variables.promenljjive.t
    dt = 0.001; // EjsS Model.Variables.promenljjive.dt
    H = 0.1; // EjsS Model.Variables.promenljjive.H
    D = 0; // EjsS Model.Variables.promenljjive.D
