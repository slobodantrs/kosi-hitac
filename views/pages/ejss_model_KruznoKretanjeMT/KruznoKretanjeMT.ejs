
<!DOCTYPE html>
<html lang="<%= locale %>">
  <head>
  <% include ../../partials/head %>
   <!-- Meta opis -->
<meta name="description" content="Interaktivna simulacija ravnomernog kružnog kretanja materijalne tačke. Upoznajte se sa teorijskim osnovama, analizirajte sile i ubrzanja, i istražite kako se brzina i poluprečnik putanje utiču na dinamiku kretanja. Simulacija kreirana pomoću alata Easy Java Simulation (EJS).">

<!-- Ključne reči -->
<meta name="keywords" content="kružno kretanje, ravnomerno kružno kretanje, materijalna tačka, centripetalna sila, normalno ubrzanje, poluprečnik kružnice, simulacija, fizika, interaktivna simulacija, Easy Java Simulation, EJS, dinamika kretanja, teorija kretanja, analiza sila, ubrzanje, brzina, putanja">

<!-- Canonical link -->
<link rel="canonical" href="https://kosi-hitac.onrender.com/kruzno_kretanje">

    <title> Početna strana za Kruzno Kretanje </title>
	 <link rel="canonical" href="https://kosi-hitac.onrender.com/kruzno_kretanje" />
  </head>
  <body>
  <div class="container moj-header">
 <% include ../../partials/head %>
  
  <div class="content-wrapper moj-header">
   
    <% include ../../partials/header %>


</div>

   
     <div id="contents_kruzno_kretanje" class="intro_1">
        <div class="intro_1">
		<%- include(path1); %>
      
        </div>
        <div id="uvod_kruzno_kretanje" class="intro_2">
        <%- include(path2); %>

        </div>
      </div>
	  
   
   <div class="row">
   <div class="col-xs-12 col-md-12 col-lg-12">
   <footer>
	<% include ../../partials/scripts %>
    <% include ../../partials/footer %>
</footer>
</div>
   </div>
	</div>
	
	<script>
 
  document.addEventListener('DOMContentLoaded', () => {
  const introEl = document.getElementById('uvod_kruzno_kretanje');
  document.getElementById('contents_kruzno_kretanje').addEventListener('click', async e => {
    const a = e.target.closest('a[data-id]');
    if (!a) return;
    e.preventDefault();
    
    /* 1) дохвати HTML фрагмент*/
    const resp = await fetch(a.href);
    const html  = await resp.text();
    
    // 2) парсирај у привремени DIV
    const tmp = document.createElement('div');
    tmp.innerHTML = html;
    
    // 3) ишчупај script тагове и премести их у body
    tmp.querySelectorAll('script').forEach(old => {
	  if (old.src && old.src.includes('textresizedetector.js')) return;
      const s = document.createElement('script');
      if (old.src)        s.src = old.src;
      else                 s.textContent = old.textContent;
      document.body.appendChild(s);
    });
    
    // 4) убaci саму симулацију у uvod_slobodan_pad
    if (a.dataset.id === 'simulacija_kruzno_kretanje') {
      // simulacija: izvuci njen kontejner
      frag = tmp.querySelector('#_topFrame') || tmp.querySelector('#ejs-container');
      introEl.innerHTML = '';
      if (frag) introEl.appendChild(frag);
	  // 5) иницијализуј симулацију одмах
   if (typeof initKruznoKretanjeSimulation === 'function') {
       initKruznoKretanjeSimulation();
   }
    } else {
	 if (window._model && typeof window._model.pause === 'function') {
        window._model.pause();        // stop its internal timer
        window._model = null;         // forget it entirely
      }
      // intro stranice: uzmi sav HTML
	  
      introEl.innerHTML = tmp.innerHTML;
    }
	
  });
});

</script>

  </body>
</html>
